": true,\n          \"type\": \"text\",\n          \"tooltip\": \"Defines the number of alerts included. Default value: 50\",\n          \"description\": \"Defines the number of alerts included. The default batch size is 50.\"\n        },\n        {\n          \"title\": \"Pull Alerts Created in Past X Minutes\",\n          \"name\": \"minutes\",\n          \"type\": \"text\",\n          \"tooltip\": \"Pull the alerts created in the past X minutes.\",\n          \"required\": false,\n          \"editable\": true,\n          \"visible\": true,\n          \"value\": \"5\"\n        }\n      ]"
